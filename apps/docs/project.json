{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/docs/src",
  "prefix": "app",
  "targets": {
    "libs": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "node apps/docs/scripts/sync-libs.mjs"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["libs"],
      "outputs": ["{workspaceRoot}/dist/apps/docs"],
      "options": {
        "command": "pnpm exec ng build",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {
          "command": "pnpm exec ng build --configuration production"
        },
        "development": {
          "command": "pnpm exec ng build --configuration development"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node apps/docs/scripts/dev.mjs"
      },
      "configurations": {
        "production": {
          "command": "node apps/docs/scripts/dev.mjs --configuration production"
        },
        "development": {
          "command": "node apps/docs/scripts/dev.mjs --configuration development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["libs"],
      "options": {
        "command": "pnpm exec tsc -p tsconfig.spec.json --noEmit && pnpm exec vitest run",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "watch": {
          "command": "pnpm exec vitest"
        }
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": ["apps/docs/src/**/*.ts", "apps/docs/src/**/*.component.html"]
      }
    }
  }
}
