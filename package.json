    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@ng-doc/app": "20.2.0",
    "@ng-doc/builder": "20.2.0",
    "@ng-doc/core": "20.2.0",
    "@ng-doc/ui-kit": "20.2.0",
    "@vizdom/vizdom-ts-web": "0.1.19",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "ngx-drag-drop": "^20.0.1",
    "ngxtension": "^4.2.0",
    "octokit": "^4.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
