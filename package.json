{
  "name": "vflow-workspace",
  "version": "0.0.0",
  "scripts": {
    "start": "nx serve docs",
    "start:hybrid": "nx run-many -t build -p tag:release && nx serve docs --configuration hybrid",
    "build": "nx run-many -t build",
    "build:dev": "nx run-many -t build --configuration development",
    "watch": "nx build docs --watch --configuration development",
    "test": "nx run-many -t test",
    "e2e": "nx e2e docs-e2e",
    "lint": "nx run-many -t lint",
    "release": "nx release",
    "release:dry-run": "nx release --dry-run --yes",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
