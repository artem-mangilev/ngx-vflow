{
  "name": "vflow-workspace",
  "version": "0.0.0",
  "scripts": {
    "start": "nx serve docs",
    "build": "nx run-many -t build",
    "build:dev": "nx run-many -t build --configuration development",
    "test": "nx run-many -t test",
    "e2e": "nx e2e docs-e2e",
    "lint": "nx run-many -t lint",
    "release": "nx release",
    "release:dry-run": "nx release --dry-run --skip-publish",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/architect": "^0.2003.0",
    "@angular-devkit/core": "^20.3.0",
    "@angular-devkit/schematics": "^20.3.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@nx/js": "24.0.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "nx": "24.0.6",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@10.34.9"
}
