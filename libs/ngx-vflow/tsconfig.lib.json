/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    // `@internal` marks exports the compiler requires in the entry point, such as host directives of `vflow`: they must stay in the typings.
    "stripInternal": false,
    "inlineSources": true,
    "types": []
  },
  "exclude": ["**/*.spec.ts"]
}
