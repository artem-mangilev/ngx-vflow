{
  "projectType": "library",
  "sourceRoot": "libs/routing/src",
  "prefix": "vx",
  "name": "routing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "options": {
        "project": "libs/routing/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/routing/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/routing/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@angular-devkit/build-angular:ng-packagr",
      "outputs": ["{workspaceRoot}/dist/libs/routing"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.spec.json --noEmit && vitest run",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "watch": {
          "command": "vitest"
        }
      }
    },
    "lint": {
      "options": {
        "lintFilePatterns": ["libs/routing/**/*.ts"]
      },
      "executor": "@angular-eslint/builder:lint"
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  },
  "tags": ["release"]
}
