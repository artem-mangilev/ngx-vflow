{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    // No source aliases of the root tsconfig: the package gets `ngx-vflow` the way an application does, from
    // node_modules, where it is the built core (see devDependencies). ng-packagr accepts no source files outside
    // the package anyway. Specs and the docs use the aliases.
    "paths": {},
    // Reads the `exports` of a package, like the bundler of an application: the typings of the built core import
    // the core by its own name.
    "moduleResolution": "bundler"
  },
  "exclude": ["**/*.spec.ts"]
}
