{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/cli/src",
  "targets": {
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": ["libs/cli/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.spec.json --noEmit && vitest run",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "watch": {
          "command": "vitest"
        }
      }
    }
  }
}
